# ── /opt/bisalpro/.env  (INSTANCE A) ────────────────────────────────────────
# This file must be IDENTICAL to /opt/bisalprox/.env EXCEPT for:
#   - PORT
#   - SERVE_DOMAIN   (only if you want sticky-by-host routing)
# Fill in your real Telegram + DB credentials below.

# ---- Telegram / core (same on both instances) ----
API_ID=
API_HASH=
BOT_TOKEN=
BIN_CHANNEL=
DB_CHANNEL=
OWNER_ID=
ADMIN_IDS=
DATABASE_URL=
name=bisalpro
WORKERS=4
SLEEP_THRESHOLD=60
HAS_SSL=True

# ---- Dual-domain HA ----
DUAL_DOMAIN_ENABLED=True
DUAL_DOMAIN_WEB=web.afrahtafreeh.site
DUAL_DOMAIN_WEBX=webx.afrahtafreeh.site

# ---- Instance-specific (DIFFERENT per instance) ----
PORT=8080
# Leave SERVE_DOMAIN empty for round-robin/least_conn balancing (recommended).
# Set to 'web' here (and 'webx' on instance B) ONLY if you switch Nginx to
# sticky-by-host routing.
SERVE_DOMAIN=

# ---- Resilience tuning (identical on both instances) ----
FILE_PROPERTIES_TIMEOUT=60
TG_CHUNK_RETRY=3
TG_CHUNK_BACKOFF=2
PREPARE_REQUEST_TIMEOUT_MS=90000
