# ── /opt/bisalprox/.env  (INSTANCE B) ───────────────────────────────────────
# IDENTICAL to instance A except PORT (and SERVE_DOMAIN if using sticky-by-host).

# ---- Telegram / core (same on both instances) ----
API_ID=
API_HASH=
BOT_TOKEN=
BIN_CHANNEL=
DB_CHANNEL=
OWNER_ID=
ADMIN_IDS=
DATABASE_URL=
name=bisalpro
WORKERS=4
SLEEP_THRESHOLD=60
HAS_SSL=True

# ---- Dual-domain HA ----
DUAL_DOMAIN_ENABLED=True
DUAL_DOMAIN_WEB=web.afrahtafreeh.site
DUAL_DOMAIN_WEBX=webx.afrahtafreeh.site

# ---- Instance-specific (DIFFERENT per instance) ----
PORT=8081
# Set to 'webx' ONLY if using sticky-by-host Nginx routing; else leave empty.
SERVE_DOMAIN=

# ---- Resilience tuning (identical on both instances) ----
FILE_PROPERTIES_TIMEOUT=60
TG_CHUNK_RETRY=3
TG_CHUNK_BACKOFF=2
PREPARE_REQUEST_TIMEOUT_MS=90000
